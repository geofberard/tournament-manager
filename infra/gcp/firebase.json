{
  "hosting": {
    "site": "tournois-scuf-2026",
    "public": "web/dist",
    "ignore": [
      "infra/gcp/firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "tournois-scuf-2026-api",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
